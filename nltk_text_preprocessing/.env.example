# Copy this file to `.env` and change the values if you need to.
# This project uses NO API keys. All settings below are optional.

# Show plots in a window as well as saving them (true / false).
SHOW_PLOTS=false

# Process only the first N reviews (empty = all rows).
# TIP: a large dataset can take a while to stem; set a small number to test quickly.
SAMPLE_SIZE=

# Folder where NLTK keeps its data files (empty = NLTK default location).
NLTK_DATA=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
